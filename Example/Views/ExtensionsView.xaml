<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="using:Microsoft.Xaml.Interactivity"
      xmlns:local="using:Example.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:s="using:Smart.WinUI"
      xmlns:si="using:Smart.WinUI.Interactivity"
      xmlns:sr="using:Smart.WinUI.Resolver"
      xmlns:sv="using:Smart.WinUI.Validation"
      x:Class="Example.Views.ExtensionsView"
      mc:Ignorable="d">
    <StackPanel Padding="24" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="ExtendViewModelBase (BusyState)" />
            <Button Command="{x:Bind ViewModel.RunCommand}" Content="Run" />
            <Button Command="{x:Bind ViewModel.CountCommand}" Content="Count" AutomationProperties.AutomationId="CountButton" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.RunCount, Mode=OneWay}" AutomationProperties.AutomationId="RunCount" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CountValue, Mode=OneWay}" AutomationProperties.AutomationId="CountValue" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="ReactiveMessenger" />
            <Button Command="{x:Bind ViewModel.PingCommand}" Content="Ping" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PingCount, Mode=OneWay}" AutomationProperties.AutomationId="PingCount" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="MessageTrigger" />
            <Button Command="{x:Bind ViewModel.SendCommand}" Content="Send" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.MessageCount, Mode=OneWay}" AutomationProperties.AutomationId="MessageCount">
                <i:Interaction.Behaviors>
                    <si:MessageTrigger Label="Notify" Messenger="{x:Bind ViewModel.Messenger}">
                        <i:InvokeCommandAction Command="{x:Bind ViewModel.ReceiveCommand}" />
                    </si:MessageTrigger>
                </i:Interaction.Behaviors>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="EventRequestTrigger" />
            <Button Command="{x:Bind ViewModel.RequestCommand}" Content="Request" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.RequestedValue, Mode=OneWay}" AutomationProperties.AutomationId="RequestedValue">
                <i:Interaction.Behaviors>
                    <si:EventRequestTrigger Request="{x:Bind ViewModel.ValueRequest}">
                        <i:InvokeCommandAction Command="{x:Bind ViewModel.RequestedCommand}" />
                    </si:EventRequestTrigger>
                </i:Interaction.Behaviors>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="CancelRequestTrigger" />
            <Button Command="{x:Bind ViewModel.CloseCommand}" Content="Close" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CloseResult, Mode=OneWay}" AutomationProperties.AutomationId="CloseResult">
                <i:Interaction.Behaviors>
                    <si:CancelRequestTrigger Request="{x:Bind ViewModel.CloseRequest}">
                        <si:CancelEventAction Cancel="True" />
                    </si:CancelRequestTrigger>
                </i:Interaction.Behaviors>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="ResolveRequestTrigger" />
            <TextBox Width="160" Text="input">
                <i:Interaction.Behaviors>
                    <si:ResolveRequestTrigger Request="{x:Bind ViewModel.TextRequest}">
                        <si:ResolvePropertyAction PropertyName="Text" />
                    </si:ResolveRequestTrigger>
                </i:Interaction.Behaviors>
            </TextBox>
            <Button Command="{x:Bind ViewModel.ResolveCommand}" Content="Resolve" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ResolvedText, Mode=OneWay}" AutomationProperties.AutomationId="ResolvedText" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="DataContextResolver / Resolve" />
            <Border VerticalAlignment="Center" sr:DataContextResolver.Type="local:ResolvedViewModel">
                <TextBlock Text="{Binding Path=Message}" AutomationProperties.AutomationId="ResolverText" />
            </Border>
            <TextBlock VerticalAlignment="Center" d:DataContext="{d:DesignInstance Type=local:ResolvedViewModel}" DataContext="{sr:Resolve Type=local:ResolvedViewModel}" Text="{Binding Path=Message}" AutomationProperties.AutomationId="ResolveText" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="ValidationFocusBehavior" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <i:Interaction.Behaviors>
                    <sv:ValidationFocusBehavior Request="{x:Bind ViewModel.FocusRequest}" Target="{x:Bind ViewModel.Errors}" />
                </i:Interaction.Behaviors>
                <TextBox Width="120" s:Behavior.Key="First" AutomationProperties.AutomationId="FirstInput" />
                <TextBox Width="120" s:Behavior.Key="Second" AutomationProperties.AutomationId="SecondInput" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.ValidateCommand}" Content="Validate" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="RoutedEventAsObservable" />
            <Button x:Name="PressButton" Content="Press" />
            <TextBlock x:Name="PressCount" VerticalAlignment="Center" AutomationProperties.AutomationId="PressCount" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Width="260" VerticalAlignment="Center" Text="PropertyChangedAsObservable" />
            <Slider x:Name="ObservedSlider" Width="160" Maximum="100" Minimum="0" AutomationProperties.AutomationId="ObservedSlider" />
            <TextBlock x:Name="SliderValue" VerticalAlignment="Center" AutomationProperties.AutomationId="SliderValue" />
        </StackPanel>
    </StackPanel>
</Page>
