<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sm="using:Smart.WinUI.Markup"
      xmlns:views="using:Example.Views"
      x:Class="Example.Views.MarkupView">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" VerticalAlignment="Center" Text="Bool, Int32, Double" />
                    <Button Command="{x:Bind ViewModel.ShowCommand}" CommandParameter="{sm:Bool Value=True}" Content="Bool" />
                    <Button Command="{x:Bind ViewModel.ShowCommand}" CommandParameter="{sm:Int32 Value=32}" Content="Int32" />
                    <Button Command="{x:Bind ViewModel.ShowCommand}" CommandParameter="{sm:Double Value=2.5}" Content="Double" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Received, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" VerticalAlignment="Center" Text="EnumValues" />
                    <ComboBox Width="240" ItemsSource="{sm:EnumValues Type=views:SampleKind}" SelectedIndex="{x:Bind ViewModel.Index, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" VerticalAlignment="Center" Text="Flag" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Flag, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" VerticalAlignment="Center" Text="Text" />
                    <TextBox Width="240" Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="BoolToText" />
                    <TextBlock Text="{Binding Path=Flag, Converter={sm:BoolToText True=On, False=Off}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="BoolToVisibility" />
                    <Border Width="16" Height="16" Background="SteelBlue" Visibility="{Binding Path=Flag, Converter={sm:BoolToVisibility True=Visible, False=Collapsed}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="BoolToBrush" />
                    <Border Width="16" Height="16" Background="{Binding Path=Flag, Converter={sm:BoolToBrush True=SeaGreen, False=IndianRed}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="NullToText" />
                    <TextBlock Text="{Binding Path=Text, Converter={sm:NullToText Null=(empty), NonNull=(text), HandleEmptyString=True}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="CompareToText (Equal Smart)" />
                    <TextBlock Text="{Binding Path=Text, Converter={sm:CompareToText True=Match, False=Mismatch}, ConverterParameter=Smart}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="CompareToText (GreaterThan 0)" />
                    <TextBlock Text="{Binding Path=Index, Converter={sm:CompareToText True=Yes, False=No, Expression={sm:CompareExpression Value=GreaterThan}}, ConverterParameter=0}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="TextToBool (yes)" />
                    <CheckBox IsChecked="{Binding Path=Text, Converter={sm:TextToBool True=yes}}" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="IntToBool (1)" />
                    <CheckBox IsChecked="{Binding Path=Index, Converter={sm:IntToBool True=1}}" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Width="320" Text="TextReplace" />
                    <TextBlock Text="{Binding Path=Text, Converter={sm:TextReplace Pattern=[aeiou], Replacement=*}}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
